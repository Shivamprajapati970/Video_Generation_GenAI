# Environment Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-very-secure-random-secret-key-in-production

# Server Settings
HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL with asyncpg & psycopg2)
DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/video_gen_db
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/video_gen_db

# Redis & Celery Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Session Cookie Configuration
SESSION_COOKIE_NAME=video_gen_session
SESSION_MAX_AGE_SECONDS=604800
SESSION_SECURE_COOKIE=False
SESSION_COOKIE_SAMESITE=lax

# Free Hosted AI Providers (No paid APIs)
GROQ_API_KEY=your_groq_free_api_key_here
HF_TOKEN=optional_huggingface_free_token_here
HF_WAN_SPACE=Wan-AI/Wan2.1-I2V-14B-720P
HF_CHATTERBOX_SPACE=reach-vb/chatterbox-tts
HF_ACESTEP_SPACE=ACE-Studio/ACE-Step

# Storage Configuration
STORAGE_TYPE=local
UPLOAD_DIR=storage/uploads
OUTPUT_DIR=storage/outputs
MAX_UPLOAD_SIZE_MB=25

# Optional AWS S3 Configuration (if STORAGE_TYPE=s3)
S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
